# GEMINI_API_KEY: Required for Gemini AI API calls if used server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional webhook URL (e.g., Slack, Discord, Zapier, Make, Formspree) to forward contact enquiries
CONTACT_WEBHOOK_URL=""

# Optional confirmed public contact details (leave blank until owner confirms)
VITE_CONTACT_EMAIL=""
VITE_WHATSAPP_NUMBER=""
VITE_LINKEDIN_URL=""
VITE_FACEBOOK_URL=""
VITE_OTHER_SOCIAL_URL=""
